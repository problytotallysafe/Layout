# Layout uses the SAME Supabase project and browser-safe publishable key as Buildr.
# This keeps suite sign-in, company membership, permissions, and drawing access unified.
# Never put a Supabase service-role/secret key in Layout.
NEXT_PUBLIC_SUPABASE_URL=https://your-buildr-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_buildr_publishable_key

# Stable Buildr URL used for project-return fallback when the Buildr Android app
# is not installed. Do not use localhost or a temporary preview URL in release builds.
NEXT_PUBLIC_BUILDR_URL=https://buildr-orcin.vercel.app

# Stable Layout auth callback URL. Configure this URL in Supabase Auth redirect allow-list.
NEXT_PUBLIC_AUTH_REDIRECT_URL=https://layout-buildr.vercel.app
